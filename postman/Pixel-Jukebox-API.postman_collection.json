{
  "info": {
    "name": "Pixel Jukebox API",
    "description": "REST control surface of the Pixel Jukebox firmware. Set the `device_ip` collection variable to the board's IP address or to `pixel-jukebox.local`. Full contract: docs/jukebox-api.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "device_ip",
      "value": "192.168.4.105",
      "type": "string",
      "description": "The board's IP address or hostname, no scheme or port (e.g. 192.168.4.105 or pixel-jukebox.local)."
    }
  ],
  "item": [
    {
      "name": "Status",
      "item": [
        {
          "name": "Get Status",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://{{device_ip}}/api/v1/status",
              "protocol": "http",
              "host": [
                "{{device_ip}}"
              ],
              "path": [
                "api",
                "v1",
                "status"
              ]
            },
            "description": "Current slot, hold state, the artwork on screen, brightness and device information."
          },
          "response": []
        },
        {
          "name": "Get API Pointer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://{{device_ip}}/api/v1",
              "protocol": "http",
              "host": [
                "{{device_ip}}"
              ],
              "path": [
                "api",
                "v1"
              ]
            },
            "description": "Returns the device name and the API base path."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Control",
