                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "http://{{device_ip}}/api/v1/hold",
              "protocol": "http",
              "host": [
                "{{device_ip}}"
              ],
              "path": [
                "api",
                "v1",
                "hold"
              ]
            },
            "description": "Holds the current slot on screen.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"held\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Release",
          "event": [
            {
              "listen": "test",
              "script": {
