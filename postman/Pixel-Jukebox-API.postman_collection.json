              "path": [
                "api",
                "v1",
                "slots"
              ]
            },
            "description": "Artwork only, no clock.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rotation\": [\n    {\n      \"slot\": \"makapix\",\n      \"turns\": 1\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        }
