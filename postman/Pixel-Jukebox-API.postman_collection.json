              "raw": "http://{{device_ip}}/api/v1/slots",
              "protocol": "http",
              "host": [
                "{{device_ip}}"
              ],
              "path": [
                "api",
                "v1",
                "slots"
              ]
            },
            "description": "The rotation and the slot types available."
          },
          "response": []
        },
        {
          "name": "Set Rotation (default)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "http://{{device_ip}}/api/v1/slots",
              "protocol": "http",
              "host": [
                "{{device_ip}}"
              ],
              "path": [
                "api",
                "v1",
                "slots"
              ]
            },
            "description": "Three artworks, then the clock for 10 seconds. Saved on the board; starts after the current slot finishes.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rotation\": [\n    {\n      \"slot\": \"makapix\",\n      \"turns\": 3\n    },\n    {\n      \"slot\": \"clock\",\n      \"turns\": 1\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Set Rotation (art only)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
