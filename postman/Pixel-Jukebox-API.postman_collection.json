            ],
            "url": {
              "raw": "http://{{device_ip}}/api/v1/brightness",
              "protocol": "http",
              "host": [
                "{{device_ip}}"
              ],
              "path": [
                "api",
                "v1",
                "brightness"
              ]
            },
            "description": "Sets the brightness (0-255). Saved on the board. On USB-C power, white tints above about 32.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"value\": 32\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Rotation",
