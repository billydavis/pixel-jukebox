    },
    {
      "name": "Wi-Fi",
      "item": [
        {
          "name": "Start Wi-Fi Setup",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 202', function () {",
                  "  pm.response.to.have.status(202);",
                  "});"
                ]
