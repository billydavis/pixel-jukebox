                "brightness"
              ]
            },
            "description": "Reads the brightness (0-255)."
          },
          "response": []
        },
        {
          "name": "Set Brightness",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 202', function () {",
                  "  pm.response.to.have.status(202);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
