                "{{device_ip}}"
              ],
              "path": [
                "api",
                "v1",
                "slots"
              ]
            },
            "description": "Expects 400; the rotation is left unchanged.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rotation\": [\n    {\n      \"slot\": \"nope\",\n      \"turns\": 1\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
