            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "http://{{device_ip}}/api/v1/wifi/setup",
              "protocol": "http",
              "host": [
                "{{device_ip}}"
              ],
              "path": [
                "api",
                "v1",
                "wifi",
                "setup"
              ]
            },
            "description": "Restarts the board into its setup hotspot (network name Pixel-Jukebox). The board goes offline; it rejoins the saved network after three minutes if nobody connects."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Error cases",
      "item": [
        {
          "name": "Brightness Out Of Range",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 400', function () {",
                  "  pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "http://{{device_ip}}/api/v1/brightness",
              "protocol": "http",
              "host": [
                "{{device_ip}}"
              ],
              "path": [
                "api",
                "v1",
                "brightness"
              ]
            },
            "description": "Expects 400; the brightness is left unchanged.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"value\": 300\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Hold With Wrong Type",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 400', function () {",
                  "  pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "http://{{device_ip}}/api/v1/hold",
              "protocol": "http",
              "host": [
                "{{device_ip}}"
              ],
              "path": [
                "api",
                "v1",
                "hold"
              ]
            },
            "description": "Expects 400; held must be a JSON boolean.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"held\": \"yes\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
