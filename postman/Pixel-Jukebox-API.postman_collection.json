              "raw": "http://{{device_ip}}/api/v1/next",
              "protocol": "http",
              "host": [
                "{{device_ip}}"
              ],
              "path": [
                "api",
                "v1",
                "next"
              ]
            },
            "description": "Skips to the next slot. Also releases a hold. Queued: read Get Status to see the result."
          },
          "response": []
        },
        {
          "name": "Hold",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
